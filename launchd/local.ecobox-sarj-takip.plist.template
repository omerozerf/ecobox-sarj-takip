<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: scripts/install_launchd.sh replaces __PROJECT_DIR__ and writes the result to
     ~/Library/LaunchAgents/local.ecobox-sarj-takip.plist -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.ecobox-sarj-takip</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>-m</string>
        <string>ecobox</string>
        <string>run</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- Do not restart more often than every 30 s if the process keeps dying. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/ecobox.out.log</string>

    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/ecobox.err.log</string>
</dict>
</plist>
