# Kopyalayın: cp .env.example .env  — .env git'e girmez.

# Telegram (boş bırakılırsa yalnızca kaydedici çalışır)
TELEGRAM_BOT_TOKEN=
# Boşsa bot, yazan her sohbete kendi chat id'sini söyler ve başka bir şey yapmaz.
TELEGRAM_CHAT_ID=

# Slack (token ve üye id'si ikisi de doluysa çalışır; Telegram'dan bağımsızdır)
# Bot User OAuth Token (xoxb-...). Kapsamlar: chat:write, groups:write, groups:read,
# groups:history ve grafikler için files:write
SLACK_BOT_TOKEN=
# Sizin Slack üye id'niz (profil > ⋮ > "Copy member ID"), ör. U0123ABCD
SLACK_USER_ID=
# İlk açılışta bot bu adla özel bir kanal açar ve sizi davet eder.
# Bu ad Slack'te zaten kullanılıyorsa Slack tarafı başlamaz; kullanılmayan bir ad seçin.
SLACK_CHANNEL_NAME=ecobox-sarj
SLACK_POLL_INTERVAL_S=3

# Kaydedici
ECOBOX_POLL_INTERVAL_S=180
# Görünen kapsam: bot komutları, bildirimler ve varsayılan analiz yalnızca bunu gösterir.
# Virgülle ayrılmış terimler; displayName ya da locationName bunlardan birini içerirse eşleşir.
ECOBOX_SCOPE=hacettepe
# Kayıt kapsamı: hangi istasyonların kaydedileceği. Boş ya da yoksa tüm Ecobox siteleri
# kaydedilir (tek durum isteği zaten hepsini getirir); site karşılaştırması buna dayanır.
ECOBOX_RECORD_SCOPE=
# Önceki örnek bu katsayı x aralıktan eskiyse geçiş zamanı "belirsiz" sayılır.
ECOBOX_GAP_FACTOR=2.5
ECOBOX_STATION_REFRESH_S=86400
ECOBOX_HTTP_TIMEOUT_S=20
ECOBOX_BACKOFF_CAP_S=900
# ECOBOX_DB_PATH=data/ecobox.sqlite3

# GitHub görüntüleri: Mac uyurken GitHub Actions'ın kaydettiği durumlar, Mac'in kendi kaydı
# olmayan aralıklara eklenir. Depo herkese açık, girişsiz çekilir; boş bırakılırsa kapalı.
ECOBOX_SNAPSHOT_REPO_URL=https://github.com/omerozerf/ecobox-sarj-takip.git
ECOBOX_SNAPSHOT_BRANCH=data
# Servisin içe aktarma aralığı (sn); açılışta bir kez, sonra bu aralıkla.
ECOBOX_SNAPSHOT_IMPORT_S=3600
# GitHub toplayıcı bu kadar saniye yeni kayıt yazmazsa bota "durmuş" uyarısı gider; 0 kapatır.
ECOBOX_COLLECTOR_STALE_S=1800
ECOBOX_LOG_LEVEL=INFO

# Haftalık özet (bulgular + ısı haritası, açık olan her bota kendiliğinden gider)
# Gün: 1 = Pazartesi ... 7 = Pazar; 0 kapatır. Saat İstanbul saatidir.
DIGEST_WEEKDAY=1
DIGEST_HOUR=9
# Görünen kapsamda en az bu kadar günlük gözlem birikmeden özet gönderilmez.
DIGEST_MIN_DAYS=3

# Şarj tahmini
CAR_CHARGE_KW=10.6
KWH_PER_PERCENT=0.95
# true: energyPrice KDV dahil kabul edilir; false: üstüne tarifedeki vat eklenir.
PRICE_INCLUDES_VAT=true
