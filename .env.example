# Kopyalayın: cp .env.example .env  — .env git'e girmez.

# Telegram (boş bırakılırsa yalnızca kaydedici çalışır)
TELEGRAM_BOT_TOKEN=
# Boşsa bot, yazan her sohbete kendi chat id'sini söyler ve başka bir şey yapmaz.
TELEGRAM_CHAT_ID=

# Slack (token ve üye id'si ikisi de doluysa çalışır; Telegram'dan bağımsızdır)
# Bot User OAuth Token (xoxb-...). Kapsamlar: chat:write, groups:write, groups:read, groups:history
SLACK_BOT_TOKEN=
# Sizin Slack üye id'niz (profil > ⋮ > "Copy member ID"), ör. U0123ABCD
SLACK_USER_ID=
# İlk açılışta bot bu adla özel bir kanal açar ve sizi davet eder.
# Bu ad Slack'te zaten kullanılıyorsa Slack tarafı başlamaz; kullanılmayan bir ad seçin.
SLACK_CHANNEL_NAME=ecobox-sarj
SLACK_POLL_INTERVAL_S=3

# Kaydedici
ECOBOX_POLL_INTERVAL_S=180
# Virgülle ayrılmış terimler; displayName ya da locationName bunlardan birini içerirse kaydedilir.
# Boş değer (ECOBOX_SCOPE=) tüm istasyonları kaydeder.
ECOBOX_SCOPE=hacettepe
# Önceki örnek bu katsayı x aralıktan eskiyse geçiş zamanı "belirsiz" sayılır.
ECOBOX_GAP_FACTOR=2.5
ECOBOX_STATION_REFRESH_S=86400
ECOBOX_HTTP_TIMEOUT_S=20
ECOBOX_BACKOFF_CAP_S=900
# ECOBOX_DB_PATH=data/ecobox.sqlite3
ECOBOX_LOG_LEVEL=INFO

# Şarj tahmini
CAR_CHARGE_KW=10.6
KWH_PER_PERCENT=0.95
# true: energyPrice KDV dahil kabul edilir; false: üstüne tarifedeki vat eklenir.
PRICE_INCLUDES_VAT=true
